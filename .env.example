# Copy to .env.local and fill in. Never commit .env.local.
# Secrets are shared in a private DM / password manager, never in the repo or the plan doc.

# Database (Jay, J2): local Docker Postgres or a Neon branch
DATABASE_URL=

# PayPal — sandbox only, never live
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Client ID for the JS SDK buttons (safe to expose)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# LLM (James, A2) — provider TBD
LLM_API_KEY=

# Mode switches. Defaults below need no secrets.
# LLM_MODE: mock (serves mocks/classify/*.json) | live | rules
LLM_MODE=mock
# PAYPAL_MODE: mock (fake order IDs) | sandbox
PAYPAL_MODE=mock
# PAYOUT_MODE: sandbox | simulated (labeled SIMULATED in the UI)
PAYOUT_MODE=simulated
# Low so the demo triggers a payout
PAYOUT_THRESHOLD_CENTS=500

# Guards POST /api/payouts/run (header x-admin-token).
# If blank, "dev-admin" works outside production only.
ADMIN_TOKEN=
